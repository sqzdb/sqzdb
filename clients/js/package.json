{
  "name": "@sqzdb/client",
  "version": "0.16.0",
  "description": "The browser client for a sqzdb app API: sign in, run SQL as the signed-in user, keep live queries current, call the app's functions",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": ["sqzdb", "database", "client", "sql", "live-queries", "auth", "browser", "react-native"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqzdb/sqzdb.git",
    "directory": "clients/js"
  },
  "homepage": "https://github.com/sqzdb/sqzdb#the-app-api-sql-from-the-browser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
