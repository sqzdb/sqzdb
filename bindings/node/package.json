{
  "name": "sqzdb",
  "version": "0.14.0",
  "description": "An embedded SQL database for Node: concurrent writers, row policies, live queries, files, vectors, sign-in and MCP for agents",
  "keywords": [
    "database",
    "sql",
    "embedded",
    "sqlite",
    "realtime",
    "mcp",
    "row-level-security"
  ],
  "homepage": "https://sqzdb.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqzdb/sqzdb.git",
    "directory": "bindings/node"
  },
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./functions": {
      "types": "./functions.d.ts",
      "import": "./functions.mjs",
      "require": "./functions.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "functions.js",
    "functions.mjs",
    "functions.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "optionalDependencies": {
    "@sqzdb/linux-x64-gnu": "0.13.0",
    "@sqzdb/linux-x64-musl": "0.13.0",
    "@sqzdb/linux-arm64-gnu": "0.13.0",
    "@sqzdb/linux-arm64-musl": "0.13.0",
    "@sqzdb/darwin-x64": "0.13.0",
    "@sqzdb/darwin-arm64": "0.13.0"
  }
}
